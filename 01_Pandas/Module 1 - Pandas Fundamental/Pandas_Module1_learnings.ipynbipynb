      "source": [
        "# 8. Single Column Selection\n",
        "\n",
        "### Objective\n",
        "Work with only one column.\n",
        "\n",
        "### Concept\n",
        "`df[\"ColumnName\"]` returns that column as a Pandas Series."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 11,
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/plain": [
              "0      22.0\n",
              "1      38.0\n",
              "2      26.0\n",
              "3      35.0\n",
              "4      35.0\n",
